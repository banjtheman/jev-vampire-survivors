include README.md LICENSE CONTRIBUTING.md SECURITY.md THIRD_PARTY.md .env.example
recursive-include vampire_bridge *.cs *.csproj *.md
recursive-include tools *.py
recursive-include tests *.py
recursive-include docs *.md
recursive-include examples *.json *.py
prune vampire_bridge/Patcher/bin
prune vampire_bridge/Patcher/obj
prune recordings
prune runs
prune dist
prune .local
prune .venv
prune .git
global-exclude __pycache__ *.py[cod] *.dll *.exe *.pck *.so *.dylib
exclude .env
